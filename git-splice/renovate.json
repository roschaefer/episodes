{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "commitMessageTopic": "{{depName}}",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "scrut/ is a splice of our scrut fork: its dependencies are updated upstream",
      "matchFileNames": ["scrut/**", "nix/scrut.Cargo.lock"],
      "enabled": false
    }
  ]
}
